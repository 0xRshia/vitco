[Unit]
Description=Vitrin Cafe Persian application
After=network.target

[Service]
Type=simple
User=vitrin-cafe
Group=vitrin-cafe
WorkingDirectory=/opt/vitrin-cafe/current
EnvironmentFile=/etc/vitrin-cafe/app.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/opt/node/node-v22.23.2-linux-x64/bin/node /opt/vitrin-cafe/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3020
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vitrin-cafe /opt/vitrin-cafe/current/.next/cache
UMask=0077
MemoryMax=768M

[Install]
WantedBy=multi-user.target
