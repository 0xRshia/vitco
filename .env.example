DATABASE_PATH=./data/vitrin.sqlite
# Set to the canonical HTTPS origin on deployment.
APP_ORIGIN=http://localhost:3000
# Real transactional mail enables password recovery. No test codes are exposed.
RESEND_API_KEY=
MAIL_FROM=
# Real Kavenegar Verify Lookup enables phone sign-in.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
# Optional: the UUID of an existing, trusted account that handles all support tickets.
SUPPORT_USER_ID=
# Optional platform operator. Set to the ID of an existing trusted Vitco account.
PLATFORM_ADMIN_USER_ID=
# Optional Google OAuth web app. Register APP_ORIGIN/api/auth/google/callback with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Telegram notices. Register /api/telegram/webhook with the same bot and a secret token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Optional Zarinpal gateway. Leave all three empty to keep online payment disabled.
# Set a complete merchant UUID; never infer missing characters from screenshots.
ZARINPAL_MERCHANT_ID=
# Must be explicitly live or sandbox. Sandbox never charges real money.
ZARINPAL_ENV=
# Exact café IDs separated by commas without spaces, or * to explicitly allow all managed cafés.
# All enabled cafés use this one merchant account; this does not split or pay out funds.
ZARINPAL_CAFE_IDS=
# Real café directory. Credentials stay on the server; never use NEXT_PUBLIC_ variables.
CAFE_DIRECTORY_USERNAME=
CAFE_DIRECTORY_PASSWORD=
# Alternative: absolute path to the crawler's live stores.json on the same server.
# When set, the file is read instead of signing into the panel.
CAFE_DIRECTORY_FILE=
# Explicit opt-in test café for trying reservations; no real location or payments.
RESERVATION_DEMO_ENABLED=0
