DATABASE_PATH=./data/vitrin.sqlite
# Set to the canonical HTTPS origin on deployment.
APP_ORIGIN=http://localhost:3000
# Real transactional mail enables password recovery. No test codes are exposed.
RESEND_API_KEY=
MAIL_FROM=
# Real Kavenegar Verify Lookup enables phone sign-in.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
# Optional: the UUID of an existing, trusted account that handles all support tickets.
SUPPORT_USER_ID=
